		{
			"name": "5. Auditoría de Balanceo (Verificar Pod Atendedor)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code es 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Respuesta contiene Pod Name y Modelo Champion\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData.model_version).to.eql(\"5@champion\");",
							"    pm.expect(jsonData.pod_name).to.be.a('string');",
							"    console.log(\"Atendido exitosamente por réplica: \" + jsonData.pod_name);",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"MedInc\": 3.87,\n  \"HouseAge\": 28.0,\n  \"AveRooms\": 5.4,\n  \"AveBedrms\": 1.05,\n  \"Population\": 1425.0,\n  \"AveOccup\": 3.0,\n  \"Latitude\": 37.88,\n  \"Longitude\": -122.23\n}"
				},
